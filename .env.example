# Copy to .env.local for local development. Never commit real keys.

# Anthropic API key, server side only. Leave empty to run in demo mode, which replays a saved sample review.
ANTHROPIC_API_KEY=

# Optional. Raises the GitHub limit from 60 to 5,000 requests per hour and allows private repositories
# the token can read. A fine-grained token with read-only "Pull requests" and "Contents" access is enough.
GITHUB_TOKEN=

# Optional. claude-sonnet-5-5 (default, cheaper) or claude-opus-5-5 (more thorough).
REVIEW_MODEL=claude-sonnet-5-5

# Optional. Effort for the review requests: low, medium, high (default), xhigh or max.
REVIEW_EFFORT=high

# Optional limits.
MAX_CHANGED_LINES=1500
MAX_INPUT_TOKENS=120000
# Output tokens one review may use. No new file is started once it is reached.
MAX_OUTPUT_TOKENS=40000
RATE_LIMIT_REVIEWS=5
RATE_LIMIT_WINDOW_SECONDS=600
