{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/app/**/{page,layout,not-found,route}.tsx", "src/app/**/route.ts", "scripts/*.ts", "e2e/**/*.ts"],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "e2e/**/*.ts"],
  "ignore": ["src/components/base/**", "src/components/application/**"],
  "ignoreDependencies": ["tailwindcss", "@tailwindcss/typography", "tailwindcss-animate", "tailwindcss-react-aria-components"]
}
