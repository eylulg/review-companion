{
  "name": "review-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Paste a GitHub pull request URL, get a structured code review from Claude, triage it and export ready-to-paste review comments.",
  "license": "MIT",
  "author": "Eylül Güneş",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "record-fixture": "tsx scripts/record-fixture.ts",
    "knip": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@eylulg/ui": "file:../ui",
    "lucide-react": "^1.71.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "knip": "^6.44.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
